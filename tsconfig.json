{
  "compilerOptions": {
    "declaration": true,
    "target": "es2024",
    "module": "nodenext",
    "types": ["node"],
    "outDir": "build",
    "rootDir": ".",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["**/*.spec.ts"]
}
